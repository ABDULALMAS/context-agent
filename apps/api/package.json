{
  "name": "@context-bot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "user:create": "tsx scripts/create-user.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@context-bot/core": "workspace:*",
    "@context-bot/db": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "dotenv": "^18.0.9",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
