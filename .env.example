# Application configuration
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=4000
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase / PostgreSQL
# Runtime API connection: transaction pooler, port 6543.
DATABASE_URL=
# Prisma migrations only: session pooler, port 5432.
DIRECT_URL=

# Redis caching (planned; not currently used by the API).
REDIS_URL=

# Reserved; the current database-backed session design does not use this value.
SESSION_SECRET=

# Google AI integration (planned; not currently read by an application config).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_AI_STUDIO_API_KEY=

# Gmail integration (planned; not currently read by an application config).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
